# Stork Market — Supabase environment
# Copy to .env.local (git-ignored) before running the app.

# Safe to expose to the browser. Every table is RLS-protected and every
# mutation goes through a reviewed Postgres function.
NEXT_PUBLIC_SUPABASE_URL=https://gqarndebnclzfgnqyhud.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kmCFcZwNZK2XLvkCsFdhmw_6lTFzmo1

# The event this deployment serves.
NEXT_PUBLIC_STORK_EVENT_SLUG=baby-k

# Event-day hosting requires this server-only key plus the party migration.
# NEVER commit a real secret or prefix it with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# Host passcode: at least 6 characters. Required to configure or start the reveal.
# STORK_HOST_PIN=
# Optional separate random secret for signing host sessions.
# STORK_SESSION_SECRET=

# Canonical site origin used by the QR code (no path).
# NEXT_PUBLIC_STORK_SITE_URL=https://your-event-domain.com

# Local development automatically uses .data/event.sqlite when no secret key
# is configured. Explicitly allow that for a local `npm start` rehearsal only.
# STORK_ALLOW_LOCAL_STORE=true
# STORK_LOCAL_DB=/absolute/path/to/rehearsal.sqlite
